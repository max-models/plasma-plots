---
// A static PyVista figure that can be swapped for its interactive scene: a standalone HTML
// page (vtk.js inlined) exported with `plotter.trame.export_html(...)` in
// scripts/generate_docs_figures.py. The scene is only fetched on click, as each is a few MB.
import { statSync } from 'node:fs';
import { join } from 'node:path';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Props {
	/** Site-root-relative path to the scene under public/, e.g. "/pyvista/foo.html". */
	src: string;
	/** The static figure, imported from src/assets/figures. */
	image: ImageMetadata;
	alt: string;
}
const { src, image, alt } = Astro.props;
const resolvedSrc = import.meta.env.BASE_URL.replace(/\/$/, '') + src;
let size = '';
try {
	size = ` (${(statSync(join(process.cwd(), 'public', src)).size / 1e6).toFixed(1)} MB)`;
} catch {
	// the scene was not generated (no trame-pyvista): only the image is shown
}
const available = size !== '';
---

<div class="pyvista-scene-wrap">
	<figure class="pyvista-scene" data-src={resolvedSrc} style={`aspect-ratio: ${image.width} / ${image.height}`}>
		<Image src={image} alt={alt} />
	</figure>
	{
		available && (
			<p class="pyvista-caption">
				<button class="pyvista-open" type="button">
					Interactive 3-D view{size}
				</button>
				<span class="pyvista-hint" hidden>
					Drag to rotate, scroll to zoom, shift-drag to pan.
				</span>
				<a href={resolvedSrc} target="_blank" rel="noopener">
					Open in a new tab
				</a>
			</p>
		)
	}
</div>

<style>
	.pyvista-scene {
		position: relative;
		width: 100%;
		margin-block: 1.5rem 0.5rem;
		background: white;
		border-radius: 0.25rem;
		overflow: hidden;
	}
	.pyvista-scene :global(img),
	.pyvista-scene :global(iframe) {
		display: block;
		width: 100%;
		height: 100%;
		margin: 0;
		border: 0;
		object-fit: contain;
	}
	.pyvista-open {
		padding: 0.4rem 0.8rem;
		border: 1px solid var(--sl-color-text-accent);
		border-radius: 0.25rem;
		background: var(--sl-color-text-accent);
		color: var(--sl-color-black);
		font-size: var(--sl-text-sm);
		cursor: pointer;
	}
	.pyvista-open:hover,
	.pyvista-open:focus-visible {
		filter: brightness(1.1);
	}
	.pyvista-caption {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 1rem;
		margin-top: 0;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
</style>

<script>
	function mountAll() {
		document.querySelectorAll<HTMLElement>('.pyvista-scene-wrap').forEach((wrap) => {
			const figure = wrap.querySelector<HTMLElement>('.pyvista-scene')!;
			const button = wrap.querySelector<HTMLButtonElement>('.pyvista-open');
			if (!button || button.dataset.bound === 'true') return;
			button.dataset.bound = 'true';
			button.addEventListener('click', () => {
				const iframe = document.createElement('iframe');
				iframe.src = figure.dataset.src!;
				iframe.title = figure.querySelector('img')?.alt ?? 'Interactive 3-D scene';
				figure.replaceChildren(iframe);
				button.hidden = true;
				wrap.querySelector<HTMLElement>('.pyvista-hint')!.hidden = false;
			});
		});
	}

	mountAll();
	document.addEventListener('astro:page-load', mountAll);
</script>
